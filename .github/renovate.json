{
  "extends": [
    "github>Linkurious/renovate-config",
    "github>Linkurious/renovate-config:meta",
    "customManagers:dockerfileVersions"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "groupName": "browsers",
      "matchDatasources": [
        "deb"
      ],
      "separateMajorMinor": false,
      "automerge": true,
      "schedule": [
        "at any time"
      ]
    },
    {
      "description": "Google only publishes the latest Chrome build in its own apt repository",
      "matchDatasources": [
        "deb"
      ],
      "matchPackageNames": [
        "google-chrome-stable"
      ],
      "registryUrls": [
        "https://dl.google.com/linux/chrome/deb?suite=stable&components=main&binaryArch=amd64"
      ]
    },
    {
      "description": "Group all Node line updates in a single PR",
      "matchDatasources": [
        "node-version"
      ],
      "groupName": "node"
    },
    {
      "description": "Keep the Node 20 line on 20.x",
      "matchDatasources": [
        "node-version"
      ],
      "matchCurrentValue": "/^20\\./",
      "allowedVersions": "<21"
    },
    {
      "description": "Keep the Node 22 line on 22.x",
      "matchDatasources": [
        "node-version"
      ],
      "matchCurrentValue": "/^22\\./",
      "allowedVersions": "<23"
    },
    {
      "description": "Keep the Node 24 line on 24.x (bump manually when a newer line becomes mainstream)",
      "matchDatasources": [
        "node-version"
      ],
      "matchCurrentValue": "/^24\\./",
      "allowedVersions": "<25"
    }
  ]
}
